# ── FREE SETUP (recommended) ──────────────────────────────────────────────────
# Sign up at console.groq.com — free, no credit card
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Sign up at atlas.nomic.ai — free, no credit card
EMBEDDING_API_KEY=nk-...
EMBEDDING_BASE_URL=https://api-atlas.nomic.ai/v1
EMBEDDING_MODEL=nomic-embed-text-v1.5

# Sign up at cohere.com — free tier, 10,000 re-rank calls/month
COHERE_API_KEY=...

# ── OPENAI SETUP (paid, skip if using Groq + Nomic above) ────────────────────
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Sign up at smith.langchain.com — free tier for tracing
LANGSMITH_API_KEY=ls__...
