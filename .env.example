# ═══════════════════════════════════════════════════════════════════════════════
# AI Real Estate Agent — Environment Variables
# ───────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
#   cp .env.example .env
#
# FREE SETUP (no credit card required anywhere):
#   LLM     → Groq      https://console.groq.com        (free tier, fast)
#   Embed   → Nomic     https://atlas.nomic.ai           (free tier)
#   Rerank  → Cohere    https://dashboard.cohere.com     (10k calls/month free)
#   Traces  → LangSmith https://smith.langchain.com      (free tier)
#
# PAID SETUP (OpenAI only, higher quality):
#   Uncomment OPENAI_API_KEY and remove LLM_* / EMBEDDING_* lines below.
# ═══════════════════════════════════════════════════════════════════════════════


# ── LLM (chat model) ──────────────────────────────────────────────────────────
# Groq (free) — fastest option, powered by llama-3.3-70b
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# OpenAI (paid) — higher quality, GPT-4o
# Uncomment and remove the three Groq lines above to switch providers.
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o
# (leave LLM_BASE_URL unset — defaults to OpenAI)


# ── Embedding model ───────────────────────────────────────────────────────────
# Nomic (free) — 768-dim vectors, 8192 token context window
EMBEDDING_API_KEY=your_nomic_api_key_here
EMBEDDING_BASE_URL=https://api-atlas.nomic.ai/v1
EMBEDDING_MODEL=nomic-embed-text-v1.5

# OpenAI embeddings (paid) — highest quality
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# (leave EMBEDDING_BASE_URL unset — defaults to OpenAI)


# ── Cohere re-ranking ─────────────────────────────────────────────────────────
# Required for two-stage RAG. Free tier: 10,000 calls/month.
# Without this key, retrieval falls back to cosine-only (RAGAS faithfulness
# drops from 0.85 to 0.76 based on our eval suite).
# Sign up: https://dashboard.cohere.com
COHERE_API_KEY=your_cohere_api_key_here


# ── LangSmith observability ───────────────────────────────────────────────────
# Optional. Traces every agent node (guardrail, ingest, analyze, Q&A) with
# per-node latency, cosine scores, re-rank scores, and token cost per run.
# Sign up: https://smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here


# ── Tavily web search ─────────────────────────────────────────────────────────
# Optional. Used by the Deal Analyzer to pull live market data for a property
# address (comparable sales, market trends, neighborhood stats).
# Without this key, deal analysis works using only your uploaded documents.
# Sign up: https://app.tavily.com  (1,000 free searches/month)
# TAVILY_API_KEY=tvly-...
